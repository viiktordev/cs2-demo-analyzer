# Copy to .env and fill in. The .env is gitignored; this file is not, so never
# put a real key here.
#
# The server looks for .env in the working directory and then one level up, so
# a file at the repository root works both for `make run` and for running the
# binary from backend/. ENV_FILE overrides the location.
#
# Variables already set in the shell win over this file.

# --- AI analysis -------------------------------------------------------------
# Set one of the two keys. Without either, everything else still works and only
# the coaching endpoint is disabled.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Which backend to use: openai, anthropic, or auto (the default) to take
# whichever key is set. With both keys set, auto picks anthropic — name the
# provider here to override that.
# AI_PROVIDER=openai

# Override the provider's default model.
# AI_MODEL=gpt-5.5

# --- Server ------------------------------------------------------------------
# These match the flag defaults.
# ADDR=:8080
# FRONTEND_DIR=../frontend
# DATA_DIR=./data
